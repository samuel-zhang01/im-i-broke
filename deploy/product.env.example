# Prefer: python3 scripts/setup.py ~/ledger-home --build
# It creates a private installation and this file for you; no editing is needed.
# Manual local installation only: use with compose.product.yml, never home overlays.
FINANCE_INSTANCE_ID=ledger-personal
# Replace with actual matching release tags or immutable sha256 digests.
FINANCE_BACKEND_IMAGE=ghcr.io/YOUR_ORG/YOUR_REPO-backend:v1.0.0
FINANCE_FRONTEND_IMAGE=ghcr.io/YOUR_ORG/YOUR_REPO-frontend:v1.0.0
FINANCE_PORT=8080
# These two values permit localhost HTTP for initial private evaluation.
# Public HTTPS deployments MUST use public + true and set the origin and hosts.
FINANCE_DEPLOYMENT=local
FINANCE_COOKIE_SECURE=false
# Banks and brokerages are optional and can be added in the app's Settings.
# HTTPS hosting and optional operator provider credentials: docs/DEPLOYMENT.md.
