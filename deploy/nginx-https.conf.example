# Template for a HOST-based TLS proxy, not the app's internal nginx.
# Replace ledger.example.com and certificate paths with your real settings.
# Existing proxy containers need their own reachable upstream, not host loopback.
server {
    listen 80;
    server_name ledger.example.com;
    return 308 https://ledger.example.com$request_uri;
}
server {
    listen 443 ssl;
    server_name ledger.example.com;
    ssl_certificate /etc/letsencrypt/live/ledger.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ledger.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    server_tokens off;
    add_header Strict-Transport-Security "max-age=31536000" always;
    # Match the app boundary; imports are capped JSON requests, not large uploads.
    client_max_body_size 1m;
    client_body_timeout 15s;
    client_header_timeout 15s;
    access_log off;
    location / {
        proxy_pass http://127.0.0.1:18080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Proto "";
        proxy_read_timeout 120s;
    }
}
