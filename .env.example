# Existing installations: retain your existing values and Compose overlays.
# New installations: run python3 scripts/setup.py ~/ledger-home --build.
# No .env edits are needed; see docs/DEPLOYMENT.md. This file is for existing
# deployments/development. Never initialize over existing household data.
# Server-only integration credentials. Saved connections can replace these, but
# unchanged environment credentials remain the compatibility default.
SNAPTRADE_ID=
SNAPTRADE_KEY=
SNAPTRADE_SYNC_SECONDS=600
LUNCH_FLOW_API=
LUNCH_FLOW_SYNC_SECONDS=21600
INVESTMENT_PRICE_REFRESH_SECONDS=900

# Existing public installations must keep public + true, their HTTPS origin and
# explicit allowed hostnames. An auth key must live on a separate private mount.
# FINANCE_DEPLOYMENT=public
# FINANCE_PUBLIC_ORIGIN=https://finance.example.com
# FINANCE_COOKIE_SECURE=true
# FINANCE_AUTH_ENABLED=true
# FINANCE_ALLOWED_HOSTS=finance.example.com,localhost,127.0.0.1,backend
# FINANCE_BIND_ADDRESS=127.0.0.1
# FINANCE_PORT=8080

# Host/CLI overrides (the Compose files set their own container paths).
# FINANCE_DB_PATH=/private/ledger/data/finance.db
# FINANCE_AUTH_DB_PATH=/private/ledger/data/auth.db
# FINANCE_UPLOADS_PATH=/private/ledger/uploads
# FINANCE_AUTH_KEY_PATH=/private/ledger/keys/auth.key

# Only the standalone product Compose file consumes these image/project pins.
# FINANCE_INSTANCE_ID=ledger-personal
# FINANCE_BACKEND_IMAGE=ghcr.io/your-org/your-repo-backend:v1.0.0
# FINANCE_FRONTEND_IMAGE=ghcr.io/your-org/your-repo-frontend:v1.0.0

# Optional consumer authorization, independent from the personal keys above.
# Requires an allowed public HTTPS origin and approved provider application.
# LUNCH_FLOW_CLIENT_ID=
# LUNCH_FLOW_CLIENT_SECRET=
# SNAPTRADE_COMMERCIAL_ID=
# SNAPTRADE_COMMERCIAL_KEY=
